# ==============================================================================
# HireSense AI — Intelligent Resume Screening System
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Find these credentials in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 2. Python FastAPI Backend Service URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_API_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. Optional LLM Integration (OpenAI or Google Gemini)
# ------------------------------------------------------------------------------
# When set, enables deep LLM reasoning summaries and custom interview questions.
# If omitted, HireSense AI uses its 100% deterministic rule & TF-IDF heuristic engine.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Service Port Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
